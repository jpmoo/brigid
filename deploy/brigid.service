# Brigid systemd unit — reference template.
#
# Unit files can't expand ~, $HOME, or PATH, so the four marked values below are
# placeholders. Rather than copying this file and editing it, prefer the
# generator in docs/deploy.md step 5, which writes the unit with your real user,
# checkout path, and pnpm path already substituted.
#
# If you do copy this by hand, replace:
#   User=            the account that owns the checkout
#   WorkingDirectory the absolute checkout path
#   ExecStart=       output of `command -v pnpm`
#   ReadWritePaths=  the absolute checkout path again

[Unit]
Description=Brigid — self-hosted novel writing application
Documentation=https://github.com/jpmoo/brigid
# postgresql.service is a no-op if Postgres lives on another host.
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=jpmoore
WorkingDirectory=/opt/brigid
ExecStart=/usr/local/bin/pnpm start
Restart=on-failure
RestartSec=5s

# PORT/HOST come from .env.local, which the app resolves relative to its own
# source directory rather than the cwd — so this works regardless of how it is
# invoked. Set NODE_ENV here because .env.local is application config, not
# runtime config.
Environment=NODE_ENV=production

# The manuscript is the whole point of this machine; keep the blast radius small.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# Deliberately no ProtectHome= — a checkout under /home needs to stay writable
# for data/brigid.config.json, and ProtectHome=read-only would break it.
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# The checkout must stay writable: data/brigid.config.json is written here on
# first boot and again when the setup wizard establishes the database.
ReadWritePaths=/opt/brigid

StandardOutput=journal
StandardError=journal
SyslogIdentifier=brigid

[Install]
WantedBy=multi-user.target
