{
  "name": "brigid",
  "version": "0.1.0",
  "private": true,
  "description": "Brigid — a self-hosted novel writing application",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "start": "pnpm --filter @brigid/server start",
    "typecheck": "pnpm -r typecheck",
    "dev:server": "pnpm --filter @brigid/server dev",
    "dev:web": "pnpm --filter @brigid/web dev",
    "db:migrate": "pnpm --filter @brigid/db migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
