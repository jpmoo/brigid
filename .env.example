# ── Brigid — server environment ───────────────────────────────────────
# Copy to .env.local and edit. Both .env and .env.local are read, and
# .env.local wins, so you can keep a shared .env and override per host.
#
# DATABASE_URL and SESSION_SECRET are OPTIONAL. Leave them unset and the
# first run serves a setup screen that provisions PostgreSQL, generates a
# secret, and creates your account. Set them here only if you would rather
# configure the server by hand and skip the wizard.

# HTTP server — API and web app are both served on this port.
PORT=8090
HOST=0.0.0.0

# Public origin of the app (scheme + host, NO path), for CORS and cookies.
APP_ORIGIN=http://localhost:8090

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
# "Over HTTPS" means what the *browser* sees — set this even when a reverse
# proxy forwards to Brigid over plain HTTP on localhost.
SECURE_COOKIES=0

# Where the app is mounted publicly. Leave unset (or "/") to serve at the root
# of the origin. Set it when hosting under a subpath behind a reverse proxy that
# STRIPS the prefix — e.g. Caddy's `handle_path /brigid*`:
#   APP_BASE_PATH=/brigid
# Read at BUILD time by the web app (so asset URLs carry the prefix) and at RUN
# time by the server (so the session cookie's Path is scoped to this app rather
# than every app on the hostname). Re-run `pnpm build:web` after changing it.
# APP_BASE_PATH=

# --- Optional: skip the setup wizard ------------------------------------
# PostgreSQL connection for the Brigid database. If unset, established by the
# first-run wizard and persisted to data/brigid.config.json.
# DATABASE_URL=postgres://brigid:CHANGE_ME@localhost:5432/brigid

# Signs the session cookie. Generate with: openssl rand -base64 48
# If unset, auto-generated and persisted to data/brigid.config.json.
# SESSION_SECRET=CHANGE_ME_min_32_bytes

# Optional: override where the first-run config file is written.
# BRIGID_CONFIG_PATH=/var/lib/brigid/brigid.config.json

# --- Ollama -------------------------------------------------------------
# Not read from env. The Ollama base URL and the inference / summarization
# model choices are configured in Settings and stored in the database.
